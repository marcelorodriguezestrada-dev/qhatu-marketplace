# ── Firebase Admin (Firestore) — gratis, plan Spark ──
# Sacás estos 3 valores en:
# Firebase Console → ⚙️ Configuración del proyecto → Cuentas de servicio
# → Generar nueva clave privada (descarga un JSON con estos campos)
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ── Firebase Client (Auth) — necesario para que los usuarios se logueen ──
# Sacás estos 3 valores en:
# Firebase Console → ⚙️ Configuración del proyecto → Tus apps →
# (creá una "app web" si todavía no tenés una) → SDK de Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=tu-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto-id

# ── ImgBB (hosting de fotos de producto) — gratis ──
# Creá una cuenta gratis en https://api.imgbb.com/ y generá tu API key.
# Sin límite de tiempo, sin tarjeta de crédito.
IMGBB_API_KEY=tu-api-key-de-imgbb

# ── Panel de administración (/admin) ──
# Elegí cualquier contraseña — es la que vas a usar vos para entrar a
# /admin y confirmar los pagos a mano.
ADMIN_PASSWORD=elegí-una-contraseña-segura

# ── Datos de cobro (QR manual, 100% gratis) ──
# Opción A: subí una foto/captura de tu QR bancario a /public (por
# ejemplo /public/qr-pago.png) y apuntá acá:
NEXT_PUBLIC_QR_IMAGE_URL=/qr-pago.png

# Opción B (si no tenés la imagen todavía): dejá QR_IMAGE_URL vacío y
# completá estos datos — el checkout va a mostrar la cuenta en texto
# para que el comprador transfiera a mano.
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=

# ── Pre-filtro de moderación con IA (opcional, gratis con Groq) ──
# Groq tiene un plan gratuito genuino (sin tarjeta, ~14.400 requests
# por día) — mismo proveedor que ya usa la app de consultorio.
# Sacás la key en https://console.groq.com → API Keys → Create API key
# Si dejás esto vacío, la app funciona exactamente igual — simplemente
# no vas a ver la etiqueta de riesgo en /admin.
GROQ_API_KEY=

# ── Mails de turnos (Resend) — gratis, plan Free ──
# Solo hace falta si activaste "Reservar turno" para profesionales
# Premium. Sin esto configurado, la reserva de todos modos se guarda
# bien en Firestore — simplemente no se manda el mail de confirmación.
# Sacás la key gratis en https://resend.com → API Keys → Create API key
RESEND_API_KEY=
# Mientras no verifiques tu propio dominio en Resend, tenés que mandar
# desde onboarding@resend.dev (límite: 100 mails/día, y solo a
# direcciones que vos mismo verificaste en el dashboard de Resend).
EMAIL_FROM="Clasi Click <onboarding@resend.dev>"

# ── Recordatorios automáticos de turnos (Vercel Cron) ──
# Protege /api/turnos/recordatorios-automaticos para que solo Vercel
# Cron pueda dispararlo (si no lo configurás, el endpoint queda
# abierto — funciona igual, pero cualquiera podría llamarlo a mano).
# En Vercel: Project Settings → Environment Variables → CRON_SECRET
# (un valor random cualquiera). Vercel lo manda solo en el header
# Authorization de las corridas de Cron Jobs automáticamente.
CRON_SECRET=
